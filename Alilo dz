            document.getElementById('modalProductImg').src = prod.image;
            document.getElementById('modalProductName').textContent = prod.name;
            document.getElementById('modalProductPrice').textContent = prod.price.toLocaleString();
            document.getElementById('modalQtyDisplay').textContent = modalQuantity;

            calculateTotal();
            document.getElementById('orderModal').classList.remove('hidden');
        }

        function changeModalQty(delta) {
            if (modalQuantity + delta >= 1) {
                modalQuantity += delta;
                document.getElementById('modalQtyDisplay').textContent = modalQuantity;
                calculateTotal();
            }
        }

        function updateDeliveryOptions() {
            const wilayaId = parseInt(document.getElementById('wilayaSelect').value);
            const homeSpan = document.getElementById('homeShippingCost');
            const deskSpan = document.getElementById('deskShippingCost');

            if (!wilayaId) {
                homeSpan.textContent = "اختر الولاية";
                deskSpan.textContent = "اختر الولاية";
                calculateTotal();
                return;
            }

            const wilaya = wilayas.find(w => w.id === wilayaId);
            if (wilaya) {
                homeSpan.textContent = `${wilaya.home} د.ج`;
                deskSpan.textContent = `${wilaya.desk} د.ج`;
            }
            calculateTotal();
        }

        function calculateTotal() {
            let subtotal = 0;
            if (currentModalItem && !currentModalItem.isCartCheckout) {
                subtotal = currentModalItem.price * modalQuantity;
            } else {
                subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            }

            const wilayaId = parseInt(document.getElementById('wilayaSelect').value);
            const deliveryType = document.querySelector('input[name="deliveryType"]:checked').value;
            
            let shippingCost = 0;
            if (wilayaId) {
                const wilaya = wilayas.find(w => w.id === wilayaId);
                if (wilaya) {
                    shippingCost = deliveryType === 'home' ? wilaya.home : wilaya.desk;
                }
            }

            const total = subtotal + shippingCost;
            document.getElementById('subtotalDisplay').textContent = `${subtotal.toLocaleString()} د.ج`;
            document.getElementById('shippingDisplay').textContent = `${shippingCost.toLocaleString()} د.ج`;
            document.getElementById('grandTotalDisplay').textContent = `${total.toLocaleString()} د.ج`;
        }

        function closeOrderModal() { document.getElementById('orderModal').classList.add('hidden'); }

        // Cart Drawer
        function toggleCartDrawer() {
            const drawer = document.getElementById('cartDrawer');
            drawer.classList.toggle('hidden');
            renderCartItems();
        }

        function addToCart(productId) {
            const prod = products.find(p => p.id === productId);
            const existing = cart.find(item => item.id === productId);

            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({ ...prod, quantity: 1 });
            }

            updateCartBadge();
            toggleCartDrawer();
        }

        function updateCartBadge() {
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            document.getElementById('cartBadge').textContent = totalItems;
        }

        function renderCartItems() {
            const list = document.getElementById('cartItemsList');
            const drawerTotal = document.getElementById('drawerTotal');

            if (cart.length === 0) {
                list.innerHTML = `<div class="text-center py-12 text-gray-400"><i class="fa-solid fa-basket-shopping text-4xl mb-2"></i><p class="text-xs">سلة التسوق فارغة حالياً</p></div>`;
                drawerTotal.textContent = "0 د.ج";
                return;
            }

            let total = 0;
            list.innerHTML = cart.map(item => {
                const itemSubtotal = item.price * item.quantity;
                total += itemSubtotal;
                return `
                    <div class="flex items-center gap-3 bg-gray-50 p-3 rounded-xl border">
                        <img src="${item.image}" alt="${item.name}" class="w-14 h-14 object-cover rounded-lg">
                        <div class="flex-1">
                            <h4 class="font-bold text-xs text-gray-800 line-clamp-1">${item.name}</h4>
                            <span class="text-xs font-bold text-brand-700">${item.price.toLocaleString()} د.ج</span>
                            <div class="flex items-center gap-2 mt-1">
                                <button onclick="updateCartItemQty(${item.id}, -1)" class="w-5 h-5 bg-gray-200 rounded text-xs font-bold">-</button>
                                <span class="text-xs font-bold">${item.quantity}</span>
                                <button onclick="updateCartItemQty(${item.id}, 1)" class="w-5 h-5 bg-gray-200 rounded text-xs font-bold">+</button>
                            </div>
                        </div>
                        <button onclick="removeFromCart(${item.id})" class="text-red-400 hover:text-red-600 p-2"><i class="fa-solid fa-trash-can text-sm"></i></button>
                    </div>
                `;
            }).join('');

            drawerTotal.textContent = `${total.toLocaleString()} د.ج`;
        }

        function updateCartItemQty(id, delta) {
            const item = cart.find(i => i.id === id);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) removeFromCart(id);
                else { renderCartItems(); updateCartBadge(); }
            }
        }

        function removeFromCart(id) {
            cart = cart.filter(i => i.id !== id);
            renderCartItems();
            updateCartBadge();
        }

        function proceedCartToCheckout() {
            if (cart.length === 0) return;
            currentModalItem = { isCartCheckout: true };
            toggleCartDrawer();

            document.getElementById('modalProductImg').src = cart[0].image;
            document.getElementById('modalProductName').textContent = `طلب متعدّد (${cart.length} منتجات)`;
            
            const cartTotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            document.getElementById('modalProductPrice').textContent = cartTotal.toLocaleString();
            document.getElementById('modalQtyDisplay').textContent = "1";

            calculateTotal();
            document.getElementById('orderModal').classList.remove('hidden');
        }

        // Checkout Form Submit -> Submit Order to Admin Database
        function handleFormSubmit(e) {
            e.preventDefault();

            const name = document.getElementById('customerName').value;
            const phone = document.getElementById('customerPhone').value;
            const wilayaId = parseInt(document.getElementById('wilayaSelect').value);
            const wilayaObj = wilayas.find(w => w.id === wilayaId);
            const commune = document.getElementById('customerCommune').value;
            const deliveryType = document.querySelector('input[name="deliveryType"]:checked').value;

            let itemsOrdered = [];
            let subtotal = 0;

            if (currentModalItem && !currentModalItem.isCartCheckout) {
                itemsOrdered.push({ name: currentModalItem.name, quantity: modalQuantity, price: currentModalItem.price });
                subtotal = currentModalItem.price * modalQuantity;
            } else {
                itemsOrdered = cart.map(i => ({ name: i.name, quantity: i.quantity, price: i.price }));
                subtotal = cart.reduce((sum, i) => sum + (i.price * i.quantity), 0);
            }

            const shippingCost = deliveryType === 'home' ? wilayaObj.home : wilayaObj.desk;
            const grandTotal = subtotal + shippingCost;
            const orderRef = "DZ-" + Math.floor(100000 + Math.random() * 900000);

            const newOrder = {
                id: orderRef,
                date: new Date().toLocaleDateString('ar-DZ') + ' ' + new Date().toLocaleTimeString('ar-DZ', {hour: '2-digit', minute:'2-digit'}),
                customerName: name,
                customerPhone: phone,
                wilaya: wilayaObj.name,
                commune: commune || "غير محدد",
                deliveryType: deliveryType === 'home' ? 'توصيل للمنزل' : 'مكتب StopDesk',
                items: itemsOrdered,
                subtotal: subtotal,
                shippingCost: shippingCost,
                total: grandTotal,
                status: 'جديد'
            };

            orders.unshift(newOrder);
            saveOrdersToStorage();

            document.getElementById('orderRef').textContent = orderRef;
            document.getElementById('successName').textContent = name;
            document.getElementById('successPhone').textContent = phone;
            document.getElementById('successTotal').textContent = `${grandTotal.toLocaleString()} د.ج`;

            closeOrderModal();
            document.getElementById('successModal').classList.remove('hidden');

            if (currentModalItem && currentModalItem.isCartCheckout) {
                cart = [];
                updateCartBadge();
            }
            document.getElementById('checkoutForm').reset();
        }

        function closeSuccessModal() { document.getElementById('successModal').classList.add('hidden'); }

        // ADMIN PANEL CONTROLLERS
        function openAdminLoginModal() {
            if (isAdminLoggedIn) {
                showAdminDashboard();
            } else {
                document.getElementById('adminLoginModal').classList.remove('hidden');
            }
        }
        function closeAdminLoginModal() { document.getElementById('adminLoginModal').classList.add('hidden'); }

        function handleAdminLogin(e) {
            e.preventDefault();
            const user = document.getElementById('adminUser').value;
            const pass = document.getElementById('adminPass').value;

            if (user === 'admin' && pass === adminPass) {
                isAdminLoggedIn = true;
                closeAdminLoginModal();
                showAdminDashboard();
            } else {
                alert('اسم المستخدم أو كلمة المرور غير صحيحة!');
            }
        }

        function showAdminDashboard() {
            document.getElementById('storefrontView').classList.add('hidden');
            document.getElementById('adminDashboardView').classList.remove('hidden');
            document.getElementById('topAnnouncementBar').classList.add('hidden');
            renderAdminAll();
        }

        function exitAdminView() {
            document.getElementById('adminDashboardView').classList.add('hidden');
            document.getElementById('storefrontView').classList.remove('hidden');
            document.getElementById('topAnnouncementBar').classList.remove('hidden');
            renderProducts();
        }

        function adminLogout() {
            isAdminLoggedIn = false;
            exitAdminView();
        }

        function switchAdminTab(tabName) {
            document.querySelectorAll('.admin-tab-btn').forEach(btn => {
                btn.classList.remove('bg-emerald-600', 'text-white', 'shadow');
                btn.classList.add('bg-white', 'text-gray-600');
            });
            document.querySelectorAll('.admin-tab-content').forEach(content => content.classList.add('hidden'));

            const activeBtn = document.getElementById(`tabBtn-${tabName}`);
            if (activeBtn) {
                activeBtn.classList.remove('bg-white', 'text-gray-600');
                activeBtn.classList.add('bg-emerald-600', 'text-white', 'shadow');
            }
            document.getElementById(`adminTab-${tabName}`).classList.remove('hidden');
        }

        function renderAdminAll() {
            renderAdminStats();
            renderAdminOrders();
            renderAdminProducts();
            renderAdminShipping();
        }

        function updatePendingBadge() {
            const pendingCount = orders.filter(o => o.status === 'جديد').length;
            document.getElementById('adminPendingCount').textContent = pendingCount;
            document.getElementById('statPendingOrders').textContent = pendingCount;
        }

        function renderAdminStats() {
            const totalRevenue = orders.filter(o => o.status === 'تم التوصيل').reduce((sum, o) => sum + o.total, 0);
            document.getElementById('statTotalRevenue').textContent = `${totalRevenue.toLocaleString()} د.ج`;
            document.getElementById('statTotalOrders').textContent = orders.length;
            document.getElementById('statTotalProducts').textContent = products.length;
            updatePendingBadge();
        }

        function renderAdminOrders() {
            const filter = document.getElementById('adminOrderFilter').value;
            const tbody = document.getElementById('adminOrdersTableBody');

            let filteredOrders = orders;
            if (filter !== 'all') {
                filteredOrders = orders.filter(o => o.status === filter);
            }

            if (filteredOrders.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="p-6 text-center text-gray-400">لا توجد طلبات مسجلة حالياً.</td></tr>`;
                return;
            }

            tbody.innerHTML = filteredOrders.map(o => `
                <tr class="hover:bg-gray-50 transition">
                    <td class="p-3 font-bold text-emerald-700">${o.id}<br><span class="text-[10px] text-gray-400">${o.date}</span></td>
                    <td class="p-3 font-semibold">${o.customerName}<br><span class="text-[10px] text-gray-500 font-mono" dir="ltr">${o.customerPhone}</span></td>
                    <td class="p-3">${o.wilaya}<br><span class="text-[10px] text-gray-400">${o.commune}</span></td>
                    <td class="p-3">
                        <ul class="list-disc list-inside text-[10px] text-gray-600">
                            ${o.items.map(i => `<li>${i.name} (x${i.quantity})</li>`).join('')}
                        </ul>
                    </td>
                    <td class="p-3"><span class="bg-blue-50 text-blue-700 px-2 py-0.5 rounded text-[10px] font-bold">${o.deliveryType}</span></td>
                    <td class="p-3 font-extrabold text-gray-800">${o.total.toLocaleString()} د.ج</td>
                    <td class="p-3">
                        <select onchange="updateOrderStatus('${o.id}', this.value)" class="text-[11px] font-bold px-2 py-1 rounded-lg border bg-white ${
                            o.status === 'جديد' ? 'text-amber-600 border-amber-300' :
                            o.status === 'قيد التوصيل' ? 'text-blue-600 border-blue-300' :
                            o.status === 'تم التوصيل' ? 'text-emerald-600 border-emerald-300' : 'text-red-600 border-red-300'
                        }">
                            <option value="جديد" ${o.status === 'جديد' ? 'selected' : ''}>جديد</option>
                            <option value="قيد التوصيل" ${o.status === 'قيد التوصيل' ? 'selected' : ''}>قيد التوصيل</option>
                            <option value="تم التوصيل" ${o.status === 'تم التوصيل' ? 'selected' : ''}>تم التوصيل</option>
                            <option value="ملغى" ${o.status === 'ملغى' ? 'selected' : ''}>ملغى</option>
                        </select>
                    </td>
                    <td class="p-3 text-center">
                        <button onclick="deleteOrder('${o.id}')" class="text-red-500 hover:text-red-700 p-1" title="حذف الطلب"><i class="fa-solid fa-trash-can"></i></button>
                    </td>
                </tr>
            `).join('');
        }

        function updateOrderStatus(orderId, newStatus) {
            const order = orders.find(o => o.id === orderId);
            if (order) {
                order.status = newStatus;
                saveOrdersToStorage();
                renderAdminStats();
            }
        }

        function deleteOrder(orderId) {
            if (confirm('هل أنت تأكد من إزالة هذا الطلب نهائياً؟')) {
                orders = orders.filter(o => o.id !== orderId);
                saveOrdersToStorage();
                renderAdminAll();
            }
        }

        // Admin Product Editor Functions
        function renderAdminProducts() {
            const tbody = document.getElementById('adminProductsTableBody');
            tbody.innerHTML = products.map(p => `
                <tr class="hover:bg-gray-50 transition">
                    <td class="p-3"><img src="${p.image}" class="w-10 h-10 object-cover rounded-lg border" onerror="this.src='https://placehold.co/100?text=بلا+صورة'"></td>
                    <td class="p-3 font-bold text-gray-800">${p.name}</td>
                    <td class="p-3 text-gray-500">${p.category}</td>
                    <td class="p-3 font-bold text-emerald-700">${p.price.toLocaleString()} د.ج ${p.oldPrice ? `<span class="text-gray-400 text-[10px] line-through block">${p.oldPrice.toLocaleString()} د.ج</span>` : ''}</td>
                    <td class="p-3">${p.badge ? `<span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded">${p.badge}</span>` : '-'}</td>
                    <td class="p-3 text-center">
                        <div class="flex items-center justify-center gap-2">
                            <button onclick="editProduct(${p.id})" class="text-blue-600 hover:text-blue-800 p-1"><i class="fa-solid fa-pen-to-square"></i></button>
                            <button onclick="deleteProduct(${p.id})" class="text-red-500 hover:text-red-700 p-1"><i class="fa-solid fa-trash-can"></i></button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        function handleSaveProduct(e) {
            e.preventDefault();
            const editId = document.getElementById('editingProductId').value;
            const name = document.getElementById('adminProdName').value;
            const category = document.getElementById('adminProdCategory').value;
            const price = parseFloat(document.getElementById('adminProdPrice').value);
            const oldPrice = parseFloat(document.getElementById('adminProdOldPrice').value) || 0;
            const image = document.getElementById('adminProdImage').value;
            const badge = document.getElementById('adminProdBadge').value;

            if (editId) {
                const prod = products.find(p => p.id === parseInt(editId));
                if (prod) {
                    prod.name = name; prod.category = category; prod.price = price;
                    prod.oldPrice = oldPrice; prod.image = image; prod.badge = badge;
                }
            } else {
                const newProd = {
                    id: Date.now(),
                    name: name, category: category, price: price,
                    oldPrice: oldPrice, image: image, badge: badge
                };
                products.unshift(newProd);
            }

            saveProductsToStorage();
            resetProductForm();
            renderAdminProducts();
            renderAdminStats();
        }

        function editProduct(id) {
            const prod = products.find(p => p.id === id);
            if (!prod) return;

            document.getElementById('editingProductId').value = prod.id;
            document.getElementById('adminProdName').value = prod.name;
            document.getElementById('adminProdCategory').value = prod.category;
            document.getElementById('adminProdPrice').value = prod.price;
            document.getElementById('adminProdOldPrice').value = prod.oldPrice || '';
            document.getElementById('adminProdImage').value = prod.image;
            document.getElementById('adminProdBadge').value = prod.badge || '';

            document.getElementById('adminProductFormTitle').innerHTML = `<i class="fa-solid fa-pen-to-square text-blue-600"></i> تعديل بيانات المنتج الحالي`;
        }

        function resetProductForm() {
            document.getElementById('editingProductId').value = '';
            document.getElementById('adminAddProductForm').reset();
            document.getElementById('adminProductFormTitle').innerHTML = `<i class="fa-solid fa-plus-circle text-brand-600"></i> إضافة منتج جديد للمتجر`;
        }

        function deleteProduct(id) {
            if (confirm('هل أنت متأكد من حذف هذا المنتج؟')) {
                products = products.filter(p => p.id !== id);
                saveProductsToStorage();
                renderAdminProducts();
                renderAdminStats();
            }
        }

        // Admin Shipping Rates
        function renderAdminShipping() {
            const tbody = document.getElementById('adminShippingTableBody');
            tbody.innerHTML = wilayas.map(w => `
                <tr class="hover:bg-gray-50 transition">
                    <td class="p-3 font-bold text-gray-800">${w.name}</td>
                    <td class="p-3"><input type="number" id="shipHome-${w.id}" value="${w.home}" class="w-24 px-2 py-1 border rounded text-xs"></td>
                    <td class="p-3"><input type="number" id="shipDesk-${w.id}" value="${w.desk}" class="w-24 px-2 py-1 border rounded text-xs"></td>
                    <td class="p-3 text-center">
                        <button onclick="saveWilayaRates(${w.id})" class="bg-emerald-600 text-white px-3 py-1 rounded text-xs font-bold hover:bg-emerald-700">تحديث</button>
                    </td>
                </tr>
            `).join('');
        }

        function saveWilayaRates(id) {
            const homeVal = parseFloat(document.getElementById(`shipHome-${id}`).value);
            const deskVal = parseFloat(document.getElementById(`shipDesk-${id}`).value);

            const wilaya = wilayas.find(w => w.id === id);
            if (wilaya) {
                wilaya.home = homeVal;
                wilaya.desk = deskVal;
                saveWilayasToStorage();
                alert(`تم تحديث أسعار التوصيل لـ ${wilaya.name} بنجاح!`);
            }
        }

        function handleUpdatePassword(e) {
            e.preventDefault();
            const curr = document.getElementById('currentPass').value;
            const newP = document.getElementById('newPass').value;

            if (curr === adminPass) {
                adminPass = newP;
                localStorage.setItem('dz_admin_pass', newP);
                alert('تم تغيير كلمة المرور بنجاح!');
                document.getElementById('currentPass').value = '';
                document.getElementById('newPass').value = '';
            } else {
                alert('كلمة المرور الحالية غير صحيحة!');
            }
        }
    </script>
</body>
</html>
