<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>متجر ALILO DZ - متجرك الإلكتروني المفضل مع لوحة التحكم</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                            900: '#064e3b',
                        },
                        admin: {
                            50: '#f8fafc',
                            100: '#f1f5f9',
                            700: '#334155',
                            800: '#1e293b',
                            900: '#0f172a'
                        }
                    },
                    fontFamily: {
                        cairo: ['Cairo', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Cairo', sans-serif; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #10b981; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #059669; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">

    <!-- Announcement Header Bar -->
    <div id="topAnnouncementBar" class="bg-brand-900 text-white text-xs sm:text-sm py-2 px-4 flex justify-between items-center transition-all">
        <div class="hidden md:flex items-center gap-4">
            <span><i class="fa-solid fa-truck-fast text-emerald-400 ml-1"></i> توصيل لكافة 58 ولاية</span>
            <span><i class="fa-solid fa-hand-holding-dollar text-emerald-400 ml-1"></i> الدفع عند الاستلام</span>
        </div>
        
        <div class="flex items-center gap-3">
            <button onclick="openAdminLoginModal()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs px-3 py-1 rounded-lg font-bold flex items-center gap-1 transition shadow">
                <i class="fa-solid fa-user-shield"></i>
                <span id="adminNavBtnText">لوحة التحكم (الأدمن)</span>
            </button>
        </div>
    </div>

    <!-- MAIN STOREFRONT VIEW -->
    <div id="storefrontView" class="flex flex-col min-h-screen">
        
        <!-- Store Navigation Bar -->
        <header class="bg-white shadow-sm sticky top-0 z-30">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between h-20">
                    
                    <!-- Store Logo -->
                    <div class="flex items-center gap-3 cursor-pointer" onclick="filterCategory('all')">
                        <div class="w-11 h-11 bg-brand-600 text-white rounded-2xl flex items-center justify-center font-bold text-2xl shadow-lg shadow-emerald-200">
                            ج
                        </div>
                        <div>
                            <span class="text-2xl font-extrabold text-gray-900 tracking-tight">متجر<span class="text-brand-600">الجزائر</span></span>
                            <span class="block text-[10px] text-gray-400 -mt-1 font-semibold">تسوق بثقة وأمان</span>
                        </div>
                    </div>

                    <!-- Search Input -->
                    <div class="hidden md:flex flex-1 max-w-md mx-8">
                        <div class="relative w-full">
                            <input type="text" id="searchInput" oninput="handleSearch()" placeholder="عما تبحث اليوم؟ (مثال: ساعة، سماعات...)" class="w-full pl-10 pr-4 py-2.5 bg-gray-100 border border-gray-200 rounded-full text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:bg-white transition-all">
                            <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-gray-400 text-sm"></i>
                        </div>
                    </div>

                    <!-- Shopping Cart Button -->
                    <div class="flex items-center gap-4">
                        <button onclick="toggleCartDrawer()" class="relative flex items-center gap-2 bg-emerald-50 hover:bg-emerald-100 text-brand-700 px-4 py-2.5 rounded-full font-bold transition">
                            <i class="fa-solid fa-bag-shopping text-xl"></i>
                            <span class="hidden sm:inline">السلة</span>
                            <span id="cartBadge" class="bg-brand-600 text-white text-xs w-6 h-6 rounded-full flex items-center justify-center font-bold">0</span>
                        </button>
                    </div>
                </div>

                <!-- Mobile Search Input -->
                <div class="md:hidden pb-4">
                    <div class="relative w-full">
                        <input type="text" id="mobileSearchInput" oninput="handleMobileSearch()" placeholder="عما تبحث اليوم؟..." class="w-full pl-10 pr-4 py-2 bg-gray-100 border border-gray-200 rounded-full text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-gray-400 text-sm"></i>
                    </div>
                </div>
            </div>
        </header>

        <!-- Hero Banner Section -->
        <section class="relative bg-gradient-to-l from-emerald-900 via-brand-900 to-gray-900 text-white py-12 lg:py-16 overflow-hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                    <div class="text-center md:text-right">
                        <span class="inline-block bg-brand-500/30 text-emerald-300 text-xs px-3 py-1 rounded-full font-semibold mb-3 border border-emerald-500/30">
                            ⚡ عروض خاصة وتوصيل لجميع الولايات
                        </span>
                        <h1 class="text-3xl sm:text-5xl font-extrabold leading-tight mb-4">
                            أفضل المنتجات العالمية <br>تصلك حتى باب منزلكم!
                        </h1>
                        <p class="text-gray-300 text-sm sm:text-base mb-6 leading-relaxed max-w-lg">
                            اكتشف تشكيلتنا المتميزة ذات الجودة العالية، مع ضمان التوصيل لـ 58 ولاية والدفع عند استلام المنتوج.
                        </p>
                        <div class="flex flex-wrap gap-3 justify-center md:justify-start">
                            <a href="#products-section" class="bg-brand-500 hover:bg-brand-600 text-white font-bold px-6 py-3 rounded-xl shadow-lg shadow-emerald-600/30 transition transform hover:-translate-y-0.5">
                                تصفح المنتجات الآن
                            </a>
                        </div>
                    </div>
                    <div class="hidden md:flex justify-center relative">
                        <div class="w-80 h-80 bg-gradient-to-tr from-brand-500 to-emerald-300 rounded-3xl rotate-6 shadow-2xl overflow-hidden flex items-center justify-center p-2">
                            <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80" alt="منتجات مميزة" class="w-full h-full object-cover rounded-2xl -rotate-6 transition duration-500 hover:rotate-0">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Main Products Display Section -->
        <main id="products-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-1">
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-gray-900">تشكيلة المنتجات المميزة</h2>
                    <p class="text-xs text-gray-500 mt-1">اختر من الفئات التالية للتصفح والطلب السريع</p>
                </div>
                
                <div class="flex items-center gap-2 overflow-x-auto pb-2" id="categoryButtons">
                    <!-- Dynamic Category buttons -->
                </div>
            </div>

            <!-- Dynamic Product Grid -->
            <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"></div>

            <div id="noResults" class="hidden text-center py-16">
                <i class="fa-solid fa-box-open text-5xl text-gray-300 mb-3"></i>
                <h3 class="text-lg font-bold text-gray-600">لم يتم العثور على أي منتج!</h3>
                <p class="text-sm text-gray-400 mt-1">جرب البحث بكلمات أخرى أو تعديل المنتجات من لوحة التحكم.</p>
            </div>
        </main>

        <!-- Footer -->
        <footer class="bg-gray-900 text-gray-400 mt-auto text-sm border-t border-gray-800">
            <div class="max-w-7xl mx-auto px-4 py-8 grid grid-cols-1 md:grid-cols-3 gap-8">
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-8 h-8 bg-brand-600 text-white rounded-lg flex items-center justify-center font-bold">ج</div>
                        <span class="text-xl font-bold text-white">متجر ALILO DZ</span>
                    </div>
                    <p class="text-xs text-gray-400 leading-relaxed">أفضل منصة إلكترونية جزائرية تقدم لكم المنتجات المتنوعة بالتوصيل لـ 58 ولاية والدفع عند الاستلام.</p>
                </div>
                <div>
                    <h4 class="text-white font-bold mb-3 text-sm">روابط سريعة</h4>
                    <ul class="space-y-2 text-xs">
                        <li><a href="#" class="hover:text-white transition">الرئيسية</a></li>
                        <li><a href="#products-section" class="hover:text-white transition">جميع المنتجات</a></li>
                        <li><button onclick="openAdminLoginModal()" class="hover:text-white transition text-left">دخول الأدمن</button></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-white font-bold mb-3 text-sm">تواصل معنا</h4>
                    <div class="space-y-2 text-xs">
                        <p><i class="fa-solid fa-phone text-brand-500 ml-2"></i> 06 72 32 73 54</p>
                        <p><i class="fa-solid fa-envelope text-brand-500 ml-2"></i> aliabdelli104.com</p>
                    </div>
                </div>
            </div>
            <div class="border-t border-gray-800 py-4 text-center text-xs text-gray-500">
                جميع الحقوق حفوظة © 2026 - متجر ALILO DZ
            </div>
        </footer>
    </div>


    <!-- ADMIN DASHBOARD FULL VIEW (Hidden by default) -->
    <div id="adminDashboardView" class="hidden min-h-screen bg-gray-100 flex flex-col">
        <!-- Admin Top Navigation Bar -->
        <header class="bg-admin-900 text-white shadow-md">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between h-16">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 bg-emerald-500 text-white rounded-xl flex items-center justify-center font-bold text-xl">
                            <i class="fa-solid fa-gears"></i>
                        </div>
                        <span class="font-bold text-lg">لوحة التحكم الرئيسية (الأدمن)</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <button onclick="exitAdminView()" class="bg-gray-800 hover:bg-gray-700 text-gray-200 px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5">
                            <i class="fa-solid fa-store"></i>
                            العودة للمتجر
                        </button>
                        <button onclick="adminLogout()" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            تسجيل الخروج
                        </button>
                    </div>
                </div>
            </div>
        </header>

        <!-- Admin Content Layout -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">
            
            <!-- Admin Navigation Tabs -->
            <div class="flex flex-wrap gap-2 border-b border-gray-200 pb-4 mb-6">
                <button onclick="switchAdminTab('stats')" id="tabBtn-stats" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 text-white shadow">
                    <i class="fa-solid fa-chart-line ml-1"></i> الإحصائيات العامة
                </button>
                <button onclick="switchAdminTab('orders')" id="tabBtn-orders" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-white text-gray-600 hover:bg-gray-200">
                    <i class="fa-solid fa-boxes-packing ml-1"></i> إدارة الطلبات (<span id="adminPendingCount">0</span>)
                </button>
                <button onclick="switchAdminTab('products')" id="tabBtn-products" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-white text-gray-600 hover:bg-gray-200">
                    <i class="fa-solid fa-box ml-1"></i> إدارة المنتجات
                </button>
                <button onclick="switchAdminTab('shipping')" id="tabBtn-shipping" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-white text-gray-600 hover:bg-gray-200">
                    <i class="fa-solid fa-truck-ramp-box ml-1"></i> أسعار الشحن (58 ولاية)
                </button>
                <button onclick="switchAdminTab('settings')" id="tabBtn-settings" class="admin-tab-btn px-4 py-2 rounded-xl text-xs font-bold bg-white text-gray-600 hover:bg-gray-200">
                    <i class="fa-solid fa-key ml-1"></i> إعدادات كلمة المرور
                </button>
            </div>

            <!-- Tab 1: Stats Overview -->
            <div id="adminTab-stats" class="admin-tab-content space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-xl font-bold">
                            <i class="fa-solid fa-sack-dollar"></i>
                        </div>
                        <div>
                            <span class="text-xs text-gray-500 font-semibold block">إجمالي الإيرادات المقبولة</span>
                            <span id="statTotalRevenue" class="text-xl font-extrabold text-gray-800">0 د.ج</span>
                        </div>
                    </div>
                    
                    <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-xl font-bold">
                            <i class="fa-solid fa-cart-flatbed"></i>
                        </div>
                        <div>
                            <span class="text-xs text-gray-500 font-semibold block">مجموع الطلبات</span>
                            <span id="statTotalOrders" class="text-xl font-extrabold text-gray-800">0</span>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl font-bold">
                            <i class="fa-solid fa-clock"></i>
                        </div>
                        <div>
                            <span class="text-xs text-gray-500 font-semibold block">طلبات قيد الانتظار</span>
                            <span id="statPendingOrders" class="text-xl font-extrabold text-gray-800">0</span>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border shadow-sm flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center text-xl font-bold">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>
                        <div>
                            <span class="text-xs text-gray-500 font-semibold block">عدد المنتجات في المتجر</span>
                            <span id="statTotalProducts" class="text-xl font-extrabold text-gray-800">0</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 2: Orders Manager -->
            <div id="adminTab-orders" class="admin-tab-content hidden space-y-4">
                <div class="bg-white p-4 rounded-2xl border shadow-sm flex flex-wrap justify-between items-center gap-3">
                    <h3 class="font-bold text-gray-800">سجل طلبات الزبائن</h3>
                    <div class="flex items-center gap-2">
                        <label class="text-xs font-bold text-gray-600">تصفية بحسب الحالة:</label>
                        <select id="adminOrderFilter" onchange="renderAdminOrders()" class="px-3 py-1.5 border rounded-xl text-xs bg-gray-50 font-semibold">
                            <option value="all">جميع الحالات</option>
                            <option value="جديد">جديد (قيد الانتظار)</option>
                            <option value="قيد التوصيل">قيد التوصيل</option>
                            <option value="تم التوصيل">تم التوصيل</option>
                            <option value="ملغى">ملغى</option>
                        </select>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border shadow-sm overflow-x-auto">
                    <table class="w-full text-right text-xs">
                        <thead class="bg-gray-50 text-gray-600 border-b">
                            <tr>
                                <th class="p-3">رقم الطلب</th>
                                <th class="p-3">الزبون والهاتف</th>
                                <th class="p-3">الولاية والعنوان</th>
                                <th class="p-3">تفاصيل الطلبية</th>
                                <th class="p-3">نوع الشحن</th>
                                <th class="p-3">المبلغ الإجمالي</th>
                                <th class="p-3">حالة الطلب</th>
                                <th class="p-3 text-center">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="adminOrdersTableBody" class="divide-y">
                            <!-- Dynamic Orders Content -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 3: Products Manager -->
            <div id="adminTab-products" class="admin-tab-content hidden space-y-6">
                <!-- Add New Product Form Card -->
                <div class="bg-white p-6 rounded-2xl border shadow-sm">
                    <h3 id="adminProductFormTitle" class="font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-plus-circle text-brand-600"></i>
                        إضافة منتج جديد للمتجر
                    </h3>
                    <form id="adminAddProductForm" onsubmit="handleSaveProduct(event)" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <input type="hidden" id="editingProductId" value="">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">اسم المنتج</label>
                            <input type="text" id="adminProdName" required placeholder="مثال: ساعة ذكية Smart Watch" class="w-full px-3 py-2 border rounded-xl text-xs focus:ring-2 focus:ring-brand-500">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">الفئة</label>
                            <select id="adminProdCategory" required class="w-full px-3 py-2 border rounded-xl text-xs focus:ring-2 focus:ring-brand-500 bg-white">
                                <option value="electronics">خواتم</option>
                                <option value="home">قلادة</option>
                                <option value="accessories">حقائب وإكسسوارات</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">السعر (د.ج)</label>
                            <input type="number" id="adminProdPrice" required min="0" placeholder="مثال: 3800" class="w-full px-3 py-2 border rounded-xl text-xs focus:ring-2 focus:ring-brand-500">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">السعر القديم (اختياري)</label>
                            <input type="number" id="adminProdOldPrice" min="0" placeholder="مثال: 4800" class="w-full px-3 py-2 border rounded-xl text-xs focus:ring-2 focus:ring-brand-500">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">رابط صورة المنتج (URL)</label>
                            <input type="url" id="adminProdImage" required placeholder="https://example.com/photo.jpg" class="w-full px-3 py-2 border rounded-xl text-xs focus:ring-2 focus:ring-brand-500" dir="ltr">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-1">شارات / شريط التخفيض</label>
                            <input type="text" id="adminProdBadge" placeholder="مثال: الأكثر مبيعاً، خصم 20%" class="w-full px-3 py-2 border rounded-xl text-xs focus:ring-2 focus:ring-brand-500">
                        </div>
                        <div class="md:col-span-3 flex justify-end gap-2 pt-2">
                            <button type="button" onclick="resetProductForm()" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-xl text-xs font-bold">إلغاء</button>
                            <button type="submit" class="px-6 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-xs font-bold shadow transition">حفظ المنتج</button>
                        </div>
                    </form>
                </div>

                <!-- Products Table -->
                <div class="bg-white rounded-2xl border shadow-sm overflow-x-auto">
                    <table class="w-full text-right text-xs">
                        <thead class="bg-gray-50 text-gray-600 border-b">
                            <tr>
                                <th class="p-3">الصورة</th>
                                <th class="p-3">اسم المنتج</th>
                                <th class="p-3">الفئة</th>
                                <th class="p-3">السعر الحسابي</th>
                                <th class="p-3">الشارة</th>
                                <th class="p-3 text-center">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="adminProductsTableBody" class="divide-y">
                            <!-- Dynamic Products List -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 4: Shipping Rates Manager -->
            <div id="adminTab-shipping" class="admin-tab-content hidden space-y-4">
                <div class="bg-white p-4 rounded-2xl border shadow-sm flex justify-between items-center">
                    <div>
                        <h3 class="font-bold text-gray-800">تعديل أسعار الشحن والتوصيل لـ 58 ولاية</h3>
                        <p class="text-xs text-gray-500">يمكنك ضبط وتحديث أسعار التوصيل للمنزل وللمكاتب لكل ولاية تلقائياً.</p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border shadow-sm overflow-x-auto max-h-[500px]">
                    <table class="w-full text-right text-xs">
                        <thead class="bg-gray-50 text-gray-600 border-b sticky top-0">
                            <tr>
                                <th class="p-3">رمز واسم الولاية</th>
                                <th class="p-3">توصيل للمنزل (د.ج)</th>
                                <th class="p-3">توصيل المكتب StopDesk (د.ج)</th>
                                <th class="p-3 text-center">تحديث</th>
                            </tr>
                        </thead>
                        <tbody id="adminShippingTableBody" class="divide-y">
                            <!-- Dynamic Wilayas List -->
                        </tbody>
                    </table>
                </div>
